---
import type { FaqItem } from '../data/fallback';

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<section id="faq" class="py-20 sm:py-28 relative bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-red-200/80 bg-red-50/80 text-mystique-accent text-xs font-medium tracking-wider uppercase mb-4 shadow-sm">
        <span>Transparence & Vérité</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-5xl font-light text-mystique-lune tracking-tight mb-4">
        Vos questions, nos réponses
      </h2>
      <p class="text-mystique-brume text-base font-light leading-relaxed">
        Des réponses claires et directes à vos questions, sans langue de bois ni détours.
      </p>
    </div>

    {/* Accordéon FAQ */}
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details
          class="group rounded-2xl bg-white border border-mystique-trait shadow-sm overflow-hidden transition-all duration-300 hover:border-mystique-accent/30 hover:shadow-md"
          open={index === 0}
        >
          <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer list-none select-none text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-mystique-accent">
            <span class="font-serif text-lg sm:text-xl text-mystique-lune font-medium group-hover:text-mystique-accent transition-colors">
              {faq.question}
            </span>
            <span class="w-8 h-8 rounded-full border border-red-200 bg-red-50 flex items-center justify-center text-mystique-accent text-xl font-light transition-transform duration-300 group-open:rotate-45 flex-shrink-0">
              +
            </span>
          </summary>

          <div class="px-6 pb-6 pt-1 text-sm sm:text-base text-mystique-brume font-light leading-relaxed border-t border-mystique-trait/60">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
