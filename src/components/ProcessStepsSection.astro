---
import { fallbackProcessSteps } from '../data/fallback';
---

<section id="deroule" class="py-20 sm:py-28 relative bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="font-serif text-3xl sm:text-5xl font-light text-mystique-lune tracking-tight mb-4">
        Comment ça se passe ?
      </h2>
      <p class="text-mystique-brume text-base sm:text-lg font-light leading-relaxed">
        4 étapes simples et directes pour débloquer votre situation rapidement.
      </p>
    </div>

    {/* Grille des 4 Étapes */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 relative">
      {fallbackProcessSteps.map((step) => (
        <div class="relative p-6 sm:p-8 rounded-3xl bg-white border border-mystique-trait hover:border-mystique-accent/40 shadow-sm hover:shadow-md transition-all flex flex-col group">
          {/* Numéro Médaillon */}
          <div class="w-12 h-12 rounded-full border border-red-200 bg-red-50 flex items-center justify-center font-serif text-xl text-mystique-accent font-semibold mb-6 shadow-sm group-hover:scale-110 transition-transform">
            {step.step}
          </div>

          <h3 class="font-serif text-xl text-mystique-lune font-medium mb-3 group-hover:text-mystique-accent transition-colors">
            {step.title}
          </h3>

          <p class="text-sm text-mystique-brume font-light leading-relaxed flex-grow">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
