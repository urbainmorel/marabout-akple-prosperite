---
import Icons from './Icons.astro';
import { fallbackTargetAudience } from '../data/fallback';
---

<section id="pourqui" class="py-20 sm:py-28 bg-mystique-encre/70 border-y border-mystique-trait/50 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      {/* Cibles Textuelles */}
      <div class="lg:col-span-7 space-y-6">
        <h2 class="font-serif text-3xl sm:text-5xl font-light text-mystique-lune tracking-tight">
          À qui s'adressent nos cérémonies ?
        </h2>

        <p class="text-mystique-brume text-base sm:text-lg font-light leading-relaxed">
          Vous travaillez dur mais l'argent bloque ou fuit à cause de jalousies ? Le sanctuaire vous apporte une réponse ciblée et rapide.
        </p>

        {/* Liste Compacte Unifiée */}
        <div class="rounded-3xl bg-white border border-mystique-trait p-6 sm:p-7 shadow-sm">
          <ul class="divide-y divide-gray-100">
            {fallbackTargetAudience.map((target) => (
              <li class="flex items-center gap-3.5 py-3 first:pt-0 last:pb-0 text-mystique-lune text-sm sm:text-base font-light">
                <span class="text-mystique-emerald flex-shrink-0">
                  <Icons name="check-circle" class="w-4 h-4" />
                </span>
                <span>{target}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Illustration Parcours Réel Optimisé */}
      <div class="lg:col-span-5">
        <div class="relative rounded-3xl overflow-hidden border border-mystique-trait shadow-mystique-card group bg-white">
          <picture>
            <source srcset="/images/parcours-elevation-spirituelle-prosperite.webp" type="image/webp" />
            <img
              src="/images/parcours-elevation-spirituelle-prosperite.jpg"
              alt="Parcours d’élévation spirituelle et de bénédiction de prospérité au temple Vodun"
              title="Cérémonie d'ouverture de prospérité et bénédiction par le Marabout Akple"
              width="720"
              height="540"
              loading="lazy"
              decoding="async"
              class="w-full h-auto aspect-[4/3] object-cover object-center group-hover:scale-105 transition-transform duration-700"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex items-end p-6">
            <p class="text-xs text-white/90 italic">
              « Toute personne sincère qui consulte reçoit une solution rituelle adaptée et rapide. »
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
