---
import Icons from './Icons.astro';
import { fallbackSettings, fallbackTrustMetrics } from '../data/fallback';
---

<section id="dignitaire" class="py-20 sm:py-28 bg-[#0B0908] border-y border-amber-500/15 relative overflow-hidden">
  {/* Lueur d'ambiance sacrée en arrière-plan */}
  <div
    class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-red-600/10 blur-[120px] pointer-events-none"
    aria-hidden="true"
  />
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-amber-600/10 blur-[120px] pointer-events-none"
    aria-hidden="true"
  />

  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      {/* Portrait Solennel du Dignitaire */}
      <div class="lg:col-span-5 order-2 lg:order-1">
        <div class="relative max-w-md mx-auto rounded-3xl overflow-hidden border border-amber-500/25 shadow-2xl group bg-[#14110F]">
          <picture>
            <source srcset="/images/marabout-akple-haut-dignitaire-vodun.webp" type="image/webp" />
            <img
              src="/images/marabout-akple-haut-dignitaire-vodun.jpg"
              alt="Marabout AKPLE, Haut Dignitaire du culte Vodun au Bénin"
              title="Marabout AKPLE — Maître spirituel et dignitaire initié du culte traditionnel Vodun"
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
              class="w-full h-auto aspect-[3/4] object-cover object-top group-hover:scale-105 transition-transform duration-700"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-transparent flex flex-col justify-end p-6">
            <span class="font-serif text-2xl text-white font-light">{fallbackSettings.practitionerName}</span>
            <span class="text-xs text-red-300 tracking-widest uppercase mt-0.5">{fallbackSettings.practitionerTitle}</span>
          </div>
        </div>
      </div>

      {/* Description & Autorité Fusionnée */}
      <div class="lg:col-span-7 order-1 lg:order-2 space-y-6">
        <h2 class="font-serif text-3xl sm:text-5xl font-light text-[#FAF6F0] tracking-tight">
          Qui est le Marabout AKPLE ?
        </h2>

        <p class="text-stone-200 text-base sm:text-lg font-normal leading-relaxed">
          Initié depuis plus de 30 ans au Bénin, le <strong class="text-[#FAF6F0] font-medium">Marabout AKPLE</strong> débloque vos finances, votre commerce et vos projets en panne.
        </p>

        <p class="text-stone-300 text-base sm:text-lg font-normal leading-relaxed">
          Héritier d’un savoir familial séculaire, il va droit au but : voyance claire du Fâ, vérité sans détour et rituels efficaces pour ouvrir vos portes.
        </p>

        {/* 3 Chiffres Clés d'Autorité */}
        <div class="grid grid-cols-3 gap-3 sm:gap-4 py-2">
          <div class="p-3 sm:p-4 rounded-2xl bg-[#14110F] border border-amber-500/20 text-center shadow-md">
            <strong class="block font-serif text-xl sm:text-2xl text-red-400 font-semibold">+30 ans</strong>
            <span class="text-xs sm:text-sm text-stone-300 font-normal">de tradition ancestrale</span>
          </div>
          <div class="p-3 sm:p-4 rounded-2xl bg-[#14110F] border border-amber-500/20 text-center shadow-md">
            <strong class="block font-serif text-xl sm:text-2xl text-red-400 font-semibold">Des milliers</strong>
            <span class="text-xs sm:text-sm text-stone-300 font-normal">de vies débloquées</span>
          </div>
          <div class="p-3 sm:p-4 rounded-2xl bg-[#14110F] border border-amber-500/20 text-center shadow-md">
            <strong class="block font-serif text-xl sm:text-2xl text-red-400 font-semibold">100 %</strong>
            <span class="text-xs sm:text-sm text-stone-300 font-normal">secret & confidentiel</span>
          </div>
        </div>

        {/* Les 4 Piliers Déontologiques */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
          <div class="p-3.5 rounded-2xl bg-[#14110F] border border-amber-500/15 shadow-sm flex items-start gap-3">
            <span class="p-1.5 rounded-xl bg-red-950/60 text-red-400 mt-0.5 border border-red-500/20 flex-shrink-0">
              <Icons name="check" class="w-3.5 h-3.5" />
            </span>
            <div>
              <h3 class="text-xs sm:text-sm font-medium text-[#FAF6F0] font-serif">Accueil direct & sincère</h3>
              <p class="text-xs sm:text-sm text-stone-300 font-normal mt-0.5">Écoute attentive sans aucun jugement.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#14110F] border border-amber-500/15 shadow-sm flex items-start gap-3">
            <span class="p-1.5 rounded-xl bg-red-950/60 text-red-400 mt-0.5 border border-red-500/20 flex-shrink-0">
              <Icons name="shield-check" class="w-3.5 h-3.5" />
            </span>
            <div>
              <h3 class="text-xs sm:text-sm font-medium text-[#FAF6F0] font-serif">Tradition pure ancestrale</h3>
              <p class="text-xs sm:text-sm text-stone-300 font-normal mt-0.5">Rituels canoniques ancestraux.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#14110F] border border-amber-500/15 shadow-sm flex items-start gap-3">
            <span class="p-1.5 rounded-xl bg-red-950/60 text-red-400 mt-0.5 border border-red-500/20 flex-shrink-0">
              <Icons name="arrow-right" class="w-3.5 h-3.5" />
            </span>
            <div>
              <h3 class="text-xs sm:text-sm font-medium text-[#FAF6F0] font-serif">Suivi pas à pas</h3>
              <p class="text-xs sm:text-sm text-stone-300 font-normal mt-0.5">Accompagnement continu jusqu'au résultat.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#14110F] border border-amber-500/15 shadow-sm flex items-start gap-3">
            <span class="p-1.5 rounded-xl bg-red-950/60 text-red-400 mt-0.5 border border-red-500/20 flex-shrink-0">
              <Icons name="lock" class="w-3.5 h-3.5" />
            </span>
            <div>
              <h3 class="text-xs sm:text-sm font-medium text-[#FAF6F0] font-serif">Éthique & Protection</h3>
              <p class="text-xs sm:text-sm text-stone-300 font-normal mt-0.5">Zéro travail pour nuire, que du positif.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
