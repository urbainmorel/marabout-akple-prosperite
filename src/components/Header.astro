---
import Icons from './Icons.astro';
import { fallbackSettings } from '../data/fallback';

const whatsappUrl = `https://wa.me/${fallbackSettings.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Bonjour Marabout AKPLE, je souhaite obtenir une consultation pour une cérémonie de prospérité.')}`;
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300 text-[#FAF6F0]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <nav class="flex items-center justify-between h-20" aria-label="Navigation principale">
      <!-- Logo -->
      <a href="/#accueil" class="group flex items-center gap-3 text-current focus:outline-none focus-visible:ring-2 focus-visible:ring-mystique-accent rounded-lg">
        <picture class="flex-shrink-0">
          <source srcset="/images/logo-marabout-akple.avif" type="image/avif" />
          <source srcset="/images/logo-marabout-akple.webp" type="image/webp" />
          <img
            src="/images/logo-marabout-akple.webp"
            alt="Logo officiel Marabout AKPLE - Dan serpent arc-en-ciel et jarre sacrée de prospérité"
            title="Sanctuaire Marabout AKPLE"
            width="413"
            height="512"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-10 sm:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
          />
        </picture>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl tracking-wide font-normal group-hover:text-amber-300 transition-colors">
            Marabout AKPLE
          </span>
          <span id="header-subtitle" class="text-[10px] uppercase tracking-widest text-amber-200/75 font-sans transition-colors">
            Sanctuaire Vodun au Bénin
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <ul id="desktop-nav" class="hidden lg:flex items-center gap-8 text-sm font-light text-stone-300 tracking-wide transition-colors">
        <li>
          <a href="/#ceremonies" class="hover:text-amber-300 transition-colors py-1">Cérémonies</a>
        </li>
        <li>
          <a href="/#dignitaire" class="hover:text-amber-300 transition-colors py-1">Qui est Akple</a>
        </li>
        <li>
          <a href="/#distance" class="hover:text-amber-300 transition-colors py-1">Présentiel ou Distance</a>
        </li>
        <li>
          <a href="/#avis" class="hover:text-amber-300 transition-colors py-1">Témoignages</a>
        </li>
        <li>
          <a href="/#faq" class="hover:text-amber-300 transition-colors py-1">FAQ</a>
        </li>
      </ul>

      <!-- Mobile Hamburger Button -->
      <button
        id="burger-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-current hover:text-amber-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-mystique-accent"
        aria-label="Ouvrir le menu de navigation"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path id="burger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden fixed inset-x-0 top-20 bg-white/95 backdrop-blur-xl border-b border-mystique-trait shadow-2xl px-6 py-6 transition-all duration-300"
  >
    <ul class="flex flex-col gap-4 text-base font-light text-mystique-brume">
      <li>
        <a href="/#ceremonies" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Cérémonies de Prospérité</a>
      </li>
      <li>
        <a href="/#reconnaitre" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Vous Vous Reconnaissez ?</a>
      </li>
      <li>
        <a href="/#dignitaire" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Qui est le Marabout AKPLE ?</a>
      </li>
      <li>
        <a href="/#distance" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Au Temple ou à Distance</a>
      </li>
      <li>
        <a href="/#avis" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Témoignages de Réussite</a>
      </li>
      <li>
        <a href="/#faq" class="mobile-nav-link block py-2 hover:text-mystique-lune border-b border-mystique-trait/40">Questions Fréquentes</a>
      </li>
      <li class="pt-2">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-3 rounded-full bg-mystique-accent text-white font-medium tracking-wide text-sm shadow-accent-glow"
        >
          <Icons name="whatsapp" class="w-5 h-5 text-white" />
          <span>Contacter sur WhatsApp</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const subtitle = document.getElementById('header-subtitle');
  const desktopNav = document.getElementById('desktop-nav');
  const burgerBtn = document.getElementById('burger-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');
  const heroSection = document.getElementById('accueil');

  // Scroll background blur and adaptive colors over dark Hero vs light sections
  const onScroll = () => {
    const isLightHeader = !heroSection || window.scrollY > 40;
    if (isLightHeader) {
      header?.classList.add('bg-white/95', 'backdrop-blur-md', 'border-b', 'border-mystique-trait', 'shadow-sm', 'text-mystique-lune');
      header?.classList.remove('text-[#FAF6F0]');
      subtitle?.classList.replace('text-amber-200/75', 'text-mystique-brume/75');
      desktopNav?.classList.replace('text-stone-300', 'text-mystique-brume');
    } else {
      header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'border-b', 'border-mystique-trait', 'shadow-sm', 'text-mystique-lune');
      header?.classList.add('text-[#FAF6F0]');
      subtitle?.classList.replace('text-mystique-brume/75', 'text-amber-200/75');
      desktopNav?.classList.replace('text-mystique-brume', 'text-stone-300');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Mobile menu toggle
  burgerBtn?.addEventListener('click', () => {
    const isExpanded = burgerBtn.getAttribute('aria-expanded') === 'true';
    burgerBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
  });

  // Close on nav link click
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      burgerBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.classList.add('hidden');
    });
  });
</script>
