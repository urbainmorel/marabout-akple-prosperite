---
import type { TestimonialItem } from '../data/fallback';

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
---

<section id="avis" class="py-20 sm:py-28 bg-mystique-encre/70 border-y border-mystique-trait/50 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-mystique-trait bg-mystique-voile/70 text-mystique-accent text-xs font-medium tracking-wider uppercase mb-4">
        <span>Retours d'Expérience Authentiques</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-5xl font-light text-mystique-lune tracking-tight mb-4">
        Ils témoignent de leur élévation
      </h2>
      <p class="text-mystique-brume text-base sm:text-lg font-light leading-relaxed">
        Des récits sincères de commerçants, entrepreneurs et consultants de la diaspora accompagnés par le Marabout AKPLE.
      </p>
    </div>

    {/* Grille des Témoignages */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonials.map((testi) => (
        <blockquote class="p-8 sm:p-10 rounded-2xl bg-mystique-voile/50 border border-mystique-trait flex flex-col justify-between hover:border-mystique-accent/40 transition-colors">
          <div>
            {/* 5 Étoiles Dorées */}
            <div class="flex items-center gap-1 mb-5" aria-label={`Note de ${testi.rating} sur 5`}>
              {[...Array(testi.rating)].map(() => (
                <span class="text-amber-400 text-base">★</span>
              ))}
            </div>

            <p class="font-serif italic font-light text-base sm:text-lg text-mystique-lune/90 leading-relaxed mb-6">
              « {testi.content} »
            </p>
          </div>

          <footer class="flex items-center gap-3 pt-4 border-t border-mystique-trait/60">
            <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-mystique-accent to-mystique-emerald flex items-center justify-center text-mystique-nuit font-serif font-semibold text-sm">
              {(testi.name || 'A')[0]}
            </div>
            <div>
              <cite class="not-italic font-medium text-sm text-mystique-lune block">
                {testi.name}
              </cite>
              <span class="text-xs text-mystique-brume block">
                {testi.role} • {testi.city}
              </span>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-xs text-mystique-brume italic">
        * Témoignages réels recueillis avec le consentement plein et entier des consultants.
      </p>
    </div>
  </div>
</section>
