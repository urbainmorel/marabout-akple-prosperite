---
import Icons from './Icons.astro';
import type { TestimonialItem } from '../data/fallback';

interface Props {
  testimonials: TestimonialItem[];
}

const { testimonials } = Astro.props;
---

<section id="avis" class="py-20 sm:py-28 bg-black border-y border-amber-500/15 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-16">
      <h2 class="font-serif text-3xl sm:text-5xl font-light text-white tracking-tight mb-4">
        Ils témoignent de leur réussite
      </h2>
      <p class="text-stone-200 text-base sm:text-lg font-normal leading-relaxed">
        Commerçants, entrepreneurs ou membres de la diaspora : découvrez comment leur situation s’est débloquée.
      </p>
    </div>

    {/* Bannière Visuelle Triptyque Réussite (Ratio 4:3) */}
    <div class="mb-12 rounded-3xl bg-neutral-900 border border-neutral-800 shadow-xl hover:border-neutral-700 transition-all overflow-hidden grid grid-cols-1 lg:grid-cols-12 items-center">
      <div class="lg:col-span-5 p-6 sm:p-10 space-y-4">
        <h3 class="font-serif text-2xl sm:text-3xl text-white font-light leading-snug">
          Du déblocage à l’abondance concrète
        </h3>
        <p class="text-stone-200 text-base sm:text-lg font-normal leading-relaxed">
          Commerçants, cadres d'entreprise et membres de la diaspora : les cérémonies traditionnelles d'Akple ouvrent la voie à des résultats matériels durables.
        </p>
        <div class="pt-2 border-t border-neutral-800 flex items-center gap-3">
          <div class="flex text-amber-400 text-sm tracking-widest" aria-label="Note de 5 sur 5">
            ★★★★★
          </div>
          <span class="text-base text-stone-200 font-medium">Plus de 180 retours positifs enregistrés</span>
        </div>
      </div>

      <div class="lg:col-span-7 h-full">
        <picture>
          <source srcset="/images/temoignages-reussite-commerce-affaires.webp" type="image/webp" />
          <img
            src="/images/temoignages-reussite-commerce-affaires.jpg"
            alt="Consultants épanouis dans leur commerce, bureau et réussite financière après les cérémonies du Marabout Akple"
            title="Témoignages de réussite et d'abondance — Marabout Akple au Bénin"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
            class="w-full h-full aspect-[4/3] object-cover object-center"
          />
        </picture>
      </div>
    </div>

    {/* Grille des Témoignages */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {testimonials.map((testi) => (
        <blockquote class="p-8 sm:p-10 rounded-3xl bg-neutral-900 border border-neutral-800 flex flex-col justify-between hover:border-amber-500/40 shadow-xl transition-all">
          <div>
            {/* 5 Étoiles Dorées */}
            <div class="flex items-center gap-1 mb-5" aria-label={`Note de ${testi.rating} sur 5`}>
              {[...Array(testi.rating)].map(() => (
                <span class="text-amber-400 text-lg">★</span>
              ))}
            </div>

            <p class="font-serif italic font-medium text-lg sm:text-xl text-stone-100 leading-relaxed mb-6">
              « {testi.content} »
            </p>
          </div>

          <footer class="flex items-center gap-3 pt-5 border-t border-neutral-800">
            <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-mystique-accent to-red-600 flex items-center justify-center text-white font-serif font-bold text-base shadow-sm shrink-0">
              {(testi.name || 'A')[0]}
            </div>
            <div>
              <cite class="not-italic font-semibold text-base sm:text-lg text-white block">
                {testi.name}
              </cite>
              <span class="text-base text-stone-200 block font-normal mt-0.5">
                {testi.role} • {testi.city}
              </span>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-base text-stone-300 font-normal italic">
        * Témoignages réels recueillis avec le consentement plein et entier des consultants.
      </p>
    </div>
  </div>
</section>
