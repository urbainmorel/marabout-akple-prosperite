---
import Icons from './Icons.astro';
import { fallbackGallery } from '../data/fallback';
---

<section id="galerie" class="py-20 sm:py-28 relative bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="font-serif text-3xl sm:text-5xl font-light text-mystique-lune tracking-tight mb-4">
        Galerie du Sanctuaire d’Ouidah
      </h2>
      <p class="text-mystique-brume text-base sm:text-lg font-light leading-relaxed">
        Un aperçu authentique de notre sanctuaire à Ouidah et de nos cérémonies. Cliquez sur une image pour l'agrandir.
      </p>
    </div>

    {/* Grille Galerie */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {fallbackGallery.map((item) => (
        <button
          type="button"
          class="gallery-item group relative rounded-3xl overflow-hidden border border-mystique-trait bg-gray-50 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-mystique-accent aspect-[4/3] block w-full cursor-zoom-in shadow-sm hover:shadow-xl transition-all duration-300"
          data-img-src={item.imageWebp}
          data-img-alt={item.title}
          data-img-caption={item.caption}
        >
          <picture>
            <source srcset={item.imageWebp} type="image/webp" />
            <img
              src={item.imageJpg}
              alt={item.title}
              width={item.width}
              height={item.height}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
            />
          </picture>
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
            <h3 class="font-serif text-lg text-white font-medium">{item.title}</h3>
            <p class="text-xs text-white/80 font-light mt-1">{item.caption}</p>
          </div>
        </button>
      ))}
    </div>
  </div>

  {/* Lightbox Modal Accessible */}
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-xl hidden place-items-center p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Image agrandie du sanctuaire"
  >
    <button
      id="lightbox-close"
      type="button"
      class="absolute top-6 right-6 p-2.5 rounded-full text-white/80 hover:text-white bg-white/10 hover:bg-white/20 border border-white/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-white transition-colors"
      aria-label="Fermer la vue agrandie"
    >
      <Icons name="close" class="w-6 h-6" />
    </button>

    <figure class="max-w-4xl w-full flex flex-col items-center">
      <div class="w-full max-h-[75vh] flex items-center justify-center overflow-hidden rounded-2xl border border-white/10 bg-black shadow-2xl">
        <img id="lightbox-img" src="" alt="" class="max-h-[75vh] w-auto object-contain" />
      </div>
      <figcaption id="lightbox-caption" class="mt-4 text-center font-serif text-lg text-white/90">
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const galleryItems = document.querySelectorAll('.gallery-item');
  const lightbox = document.getElementById('gallery-lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');

  const openLightbox = (src: string, alt: string, caption: string) => {
    if (!lightbox || !lightboxImg || !lightboxCaption) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightboxCaption.textContent = `${alt} — ${caption}`;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('grid');
    lightboxClose?.focus();
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('grid');
    document.body.style.overflow = '';
  };

  galleryItems.forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = btn.getAttribute('data-img-src') || '';
      const alt = btn.getAttribute('data-img-alt') || '';
      const caption = btn.getAttribute('data-img-caption') || '';
      openLightbox(src, alt, caption);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
