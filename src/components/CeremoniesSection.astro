---
import Icons from './Icons.astro';
import { fallbackSettings, type CeremonyItem } from '../data/fallback';

interface Props {
  ceremonies: CeremonyItem[];
}

const { ceremonies } = Astro.props;
const whatsappUrl = `https://wa.me/${fallbackSettings.whatsappNumber.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Bonjour Marabout AKPLE, je souhaite ouvrir mes chemins et solliciter une consultation de prospérité.')}`;
---

<section id="ceremonies" class="py-20 sm:py-28 relative bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light text-mystique-lune tracking-tight mb-6">
        Nos cérémonies de prospérité
      </h2>
      <p class="text-stone-700 text-base sm:text-lg font-normal leading-relaxed">
        Chaque situation est unique. Le Fâ détermine le rituel exact dont vous avez besoin pour débloquer votre argent et réussir vos projets.
      </p>
    </div>

    {/* Grille des Cérémonies : 3 cérémonies par ligne, ratio 4:3 */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ceremonies.map((ceremony) => (
        <article class="rounded-3xl border border-neutral-800 hover:border-mystique-accent/50 bg-black shadow-md hover:shadow-2xl hover:shadow-black/30 overflow-hidden transition-all duration-300 flex flex-col group">
          {/* Image Cérémonie avec Ratio 4:3 et Balisage Picture */}
          <div class="relative overflow-hidden bg-neutral-900 aspect-[4/3]">
            <picture>
              <source srcset={ceremony.imageWebp} type="image/webp" />
              <img
                src={ceremony.imageJpg}
                alt={ceremony.altText}
                title={ceremony.title}
                width={ceremony.width}
                height={ceremony.height}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
              />
            </picture>
          </div>

          {/* Contenu de la Carte */}
          <div class="p-6 sm:p-7 flex flex-col justify-start flex-grow">
            <h3 class="font-serif text-xl sm:text-2xl text-white font-normal leading-snug mb-3 group-hover:text-mystique-accent transition-colors">
              {ceremony.title}
            </h3>
            <p class="text-base sm:text-base text-stone-200 font-normal leading-relaxed">
              {ceremony.shortDescription}
            </p>
          </div>
        </article>
      ))}
    </div>

    {/* Note de Transparence & CTA Intermédiaire de Conversion */}
    <div class="mt-14 text-center max-w-xl mx-auto space-y-6">
      <p class="text-sm sm:text-base text-stone-600 font-normal italic">
        ✦ Les offrandes rituelles sont déterminées en toute clarté lors de la consultation. Zéro frais caché.
      </p>

      <div class="pt-2 space-y-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-mystique-accent hover:bg-mystique-accentHover text-white font-medium tracking-wide text-base transition-all duration-300 shadow-accent-glow hover:scale-[1.02]"
        >
          <Icons name="whatsapp" class="w-5 h-5 text-white" />
          <span>Demander une consultation sur WhatsApp</span>
        </a>
        <p class="inline-flex items-center justify-center gap-1.5 text-sm sm:text-base text-stone-600 font-medium">
          <Icons name="video" class="w-4 h-4 text-red-500 shrink-0" />
          <span>Appel vidéo WhatsApp</span>
        </p>
      </div>
    </div>
  </div>
</section>
