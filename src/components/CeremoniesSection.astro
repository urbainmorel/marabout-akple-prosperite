---
import type { CeremonyItem } from '../data/fallback';

interface Props {
  ceremonies: CeremonyItem[];
}

const { ceremonies } = Astro.props;
---

<section id="ceremonies" class="py-20 sm:py-28 relative bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-red-200/80 bg-red-50/80 text-mystique-accent text-xs font-medium tracking-wider uppercase mb-4 shadow-sm">
        <span>Parcours d'Élévation Spirituelle</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light text-mystique-lune tracking-tight mb-6">
        Nos cérémonies de prospérité
      </h2>
      <p class="text-mystique-brume text-base sm:text-lg font-light leading-relaxed">
        Chaque situation humaine est unique. Les rituels ci-dessous forment un ensemble puissant, ordonné et dosé sur-mesure selon les directives précises révélées par le Fâ.
      </p>
    </div>

    {/* Grille des Cérémonies avec Carte Principale Mise en Valeur */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ceremonies.map((ceremony) => {
        const isBig = ceremony.isMain;
        return (
          <article
            class={`rounded-3xl border border-mystique-trait hover:border-mystique-accent/40 bg-white shadow-sm hover:shadow-xl overflow-hidden transition-all duration-300 flex flex-col group ${
              isBig ? 'md:col-span-2 lg:col-span-3 grid grid-cols-1 lg:grid-cols-12' : ''
            }`}
          >
            {/* Image Cérémonie avec Ratio 4:3 et Balisage Picture */}
            <div class={`relative overflow-hidden bg-gray-50 ${isBig ? 'lg:col-span-6 min-h-[320px]' : 'aspect-[4/3]'}`}>
              <picture>
                <source srcset={ceremony.imageWebp} type="image/webp" />
                <img
                  src={ceremony.imageJpg}
                  alt={ceremony.altText}
                  title={ceremony.title}
                  width={ceremony.width}
                  height={ceremony.height}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700"
                />
              </picture>
              <div class="absolute top-4 left-4">
                <span class="px-3.5 py-1 rounded-full bg-white/95 backdrop-blur-sm border border-mystique-trait text-mystique-accent text-xs font-serif font-medium shadow-sm">
                  Étape {ceremony.stepNumber}
                </span>
              </div>
            </div>

            {/* Contenu de la Carte */}
            <div class={`p-6 sm:p-8 flex flex-col justify-between flex-grow ${isBig ? 'lg:col-span-6' : ''}`}>
              <div>
                <h3 class="font-serif text-xl sm:text-2xl text-mystique-lune font-normal leading-snug mb-3 group-hover:text-mystique-accent transition-colors">
                  {ceremony.title}
                </h3>
                <p class="text-sm sm:text-base text-mystique-brume font-light leading-relaxed mb-6">
                  {ceremony.shortDescription}
                </p>
              </div>

              <div class="pt-4 border-t border-mystique-trait/60">
                <p class="text-xs sm:text-sm text-mystique-lune font-light">
                  <strong class="text-mystique-emerald font-medium">Idéal pour : </strong>
                  {ceremony.idealFor}
                </p>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* Note de Transparence */}
    <div class="mt-12 text-center">
      <p class="text-xs sm:text-sm text-mystique-brume italic max-w-2xl mx-auto">
        ✦ Les offrandes rituelles (boissons, aliments, noix de cola sacrées, tissus) sont déterminées en concertation avec vous lors de la consultation. Clarté absolue avant tout engagement.
      </p>
    </div>
  </div>
</section>
