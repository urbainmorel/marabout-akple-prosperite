---
import Icons from './Icons.astro';
import { fallbackSettings } from '../data/fallback';

const whatsappUrl = `https://wa.me/${fallbackSettings.whatsappNumber.replace(/[^0-9]/g, '')}`;
---

<section id="contact" class="py-24 sm:py-32 relative overflow-hidden bg-black text-white border-t border-neutral-800">
  {/* Halo Lumineux Supérieur Délicat en Rouge Sacré */}
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[min(90vw,900px)] h-72 rounded-full pointer-events-none opacity-30 select-none"
    style="background: radial-gradient(ellipse at 50% 0%, rgba(220, 38, 38, 0.35), transparent 70%);"
    aria-hidden="true"
  />

  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight max-w-3xl mx-auto mb-6 leading-tight">
      Votre vie peut changer dès aujourd'hui.
    </h2>

    <p class="font-serif italic text-xl sm:text-2xl text-mystique-accent font-light mb-4">
      « La chance se provoque, la réussite se prépare. »
    </p>

    <p class="text-stone-200 text-base sm:text-lg font-normal leading-relaxed max-w-xl mx-auto mb-10">
      Au Bénin ou à l’étranger, échangez avec le Marabout AKPLE en toute discrétion. Réponse directe et sans engagement.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 px-9 py-4 rounded-full bg-mystique-emerald hover:bg-mystique-emeraldHover text-white font-medium tracking-wide text-base transition-all duration-300 shadow-emerald-glow hover:scale-[1.02]"
      >
        <Icons name="whatsapp" class="w-5 h-5 text-white" />
        <span>Consulter le Marabout AKPLE</span>
      </a>

      <a
        href={`tel:${fallbackSettings.phoneNumberBJ.replace(/\s+/g, '')}`}
        class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full border border-neutral-700 hover:border-neutral-500 bg-neutral-900/90 hover:bg-neutral-800 text-white text-base font-normal transition-all duration-300 shadow-sm"
      >
        <Icons name="phone" class="w-4 h-4 text-mystique-accent" />
        <span>Appeler : {fallbackSettings.phoneNumberBJ}</span>
      </a>
    </div>

    <div class="inline-flex items-center justify-center gap-1.5 text-base sm:text-lg text-stone-200 font-semibold">
      <Icons name="video" class="w-4 h-4 text-red-500 shrink-0" />
      <span>Appel vidéo WhatsApp</span>
    </div>
  </div>
</section>
