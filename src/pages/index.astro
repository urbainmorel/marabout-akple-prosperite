---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustSection from '../components/TrustSection.astro';
import RecognizeSection from '../components/RecognizeSection.astro';
import DignitarySection from '../components/DignitarySection.astro';
import CeremoniesSection from '../components/CeremoniesSection.astro';
import TempleOrDistanceSection from '../components/TempleOrDistanceSection.astro';
import ProcessStepsSection from '../components/ProcessStepsSection.astro';
import TargetAudienceSection from '../components/TargetAudienceSection.astro';
import GallerySection from '../components/GallerySection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import FinalCTASection from '../components/FinalCTASection.astro';
import { getSiteSettings, getCeremonies, getTestimonials, getFaqs } from '../utils/sanity';
import { generateFaqSchema } from '../utils/seo';

const settings = await getSiteSettings();
const ceremonies = await getCeremonies();
const testimonials = await getTestimonials();
const faqs = await getFaqs();
const faqSchema = generateFaqSchema();
---

<Layout
  title={settings.metaTitle}
  description={settings.metaDescription}
  jsonLd={faqSchema}
>
  <Hero />
  <TrustSection />
  <RecognizeSection />
  <DignitarySection />
  <CeremoniesSection ceremonies={ceremonies} />
  <TempleOrDistanceSection />
  <ProcessStepsSection />
  <TargetAudienceSection />
  <GallerySection />
  <TestimonialsSection testimonials={testimonials} />
  <FAQSection faqs={faqs} />
  <FinalCTASection />
</Layout>
